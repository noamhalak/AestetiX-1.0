{
  "name": "@aesthetix/ui",
  "version": "0.1.0",
  "description": "AestetiX 1.0 — React component library based on Ant Design 5 patterns with Tabler Icons and RTL (Hebrew) support",
  "keywords": [
    "react",
    "design-system",
    "ui",
    "rtl",
    "hebrew",
    "ant-design",
    "typescript"
  ],
  "author": "AestetiX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noamhalak/aesthetix-ui"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "antd": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@tabler/icons-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@tabler/icons-react": "^3.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "playwright": "^1.60.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "storybook": "^10.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.6",
    "antd": "^6.5.0"
  }
}
